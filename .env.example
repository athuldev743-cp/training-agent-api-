# Hosted API settings (set these as secrets in the host's dashboard, never in files)
API_TOKEN_SECRET=            # 32+ random characters
STATE_BACKEND=postgres
NEON_DATABASE_URL=           # Neon connection string
PG_SCHEMA=app
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
TRUST_PROXY=1                # only if the host puts a trusted proxy in front
